# Copy to configs/ramses.env (git-ignored) and fill in. No cluster values are assumed here;
# run scripts/ramses/doctor.sh on the login node to find valid ones.

# --- Slurm (leave empty to omit the option) ---
RAMSES_PARTITION=
RAMSES_ACCOUNT=
RAMSES_QOS=
# Full --gres string, e.g. "gpu:1" or "gpu:<type>:1" with the type name shown by doctor.sh
RAMSES_GRES=
RAMSES_CPUS=4
RAMSES_MEM=32G
# Wall time per profile (HH:MM:SS or D-HH:MM:SS); full jobs are resumable with --resume
RAMSES_TIME_SMOKE=00:20:00
RAMSES_TIME_PILOT=02:30:00
RAMSES_TIME_FULL=
# Optional extra sbatch arguments, e.g. "--exclude=node01"
RAMSES_SBATCH_EXTRA=

# --- Software ---
# Space-separated environment modules to load (names as in `module avail`), e.g. "python/3.11 cuda/12.1"
RAMSES_MODULES=
PYTHON_BIN=python3
RAMSES_VENV_DIR=
# Extra index for the CUDA torch wheel (Linux). Default PyPI wheel for torch 2.3.0 already ships CUDA 12.1.
TORCH_INDEX_URL=

# --- Directories (absolute; typically on a workspace/scratch file system with enough quota) ---
RAMSES_CACHE_DIR=
RAMSES_RESULTS_DIR=
RAMSES_DATA_DIR=
RAMSES_LOG_DIR=

# --- Local LLM backend (Ollama, user space) ---
OLLAMA_BIN=
# Pin a version, e.g. 0.6.8; empty = latest release
OLLAMA_VERSION=
OLLAMA_PORT=11434
